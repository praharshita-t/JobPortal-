# CampusMatch AI — Environment Variables
# Copy to .env and customize as needed.

# Database connection URL (defaults to local SQLite database)
DATABASE_URL=sqlite:///./campusmatch.db

# JWT Secret key for Argon2id session tokens
SECRET_KEY=campusmatch_super_secret_jwt_key_2026_change_in_production

# Optional: Google Gemini API Key for AI-assisted resume extraction & candidate intelligence
# If left unset, CampusMatch AI seamlessly uses its high-accuracy deterministic extraction fallback
GEMINI_API_KEY=
